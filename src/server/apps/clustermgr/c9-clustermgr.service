# systemd unit for the C9Core cluster manager, headless (web UI only).
# Install:  sudo cp c9-clustermgr.service /etc/systemd/system/ && sudo systemctl daemon-reload
#           sudo systemctl enable --now c9-clustermgr
# Requires UI.Enabled = 0 in clustermgr.conf (no terminal under systemd).
[Unit]
Description=c9core cluster manager (headless web UI)
After=network-online.target c9-nats.service
Wants=network-online.target

[Service]
Type=simple
User=reno
WorkingDirectory=/home/wow/335/bin
ExecStart=/home/wow/335/bin/clustermgr -c /home/wow/335/etc/clustermgr.conf
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
