##########################################
# C9Core Cluster Manager config file #
##########################################
[clustermgr]

###################################################################################################
# SECTION INDEX
#
#    NATS CONNECTION
#    WEB UI
#    HISTORY
#    DEPLOY DEFAULTS
#    LOGGING
#
###################################################################################################

###################################################################################################
# NATS CONNECTION
#
#    ClusterServer.NatsUrl
#        Description: NATS server URL.  Must point to the same NATS broker used by worldservers.
#                     clustermgr subscribes to cluster.mgmt.status and cluster.mgmt.players.
#        Default:     "nats://192.0.2.70:4222"

ClusterServer.NatsUrl = "nats://192.0.2.70:4222"

#
#    ClusterServer.NodeDeadThreshold
#        Description: Seconds of silence from a node's cluster.mgmt.status before it is marked
#                     CRASHED in the TUI and web UI.  Must be > ClusterServer.MgmtStatusInterval.
#        Default:     30

ClusterServer.NodeDeadThreshold = 30

#
#    ClusterServer.MgmtStatusInterval
#        Description: Expected publish interval (seconds) for cluster.mgmt.status from worldservers.
#                     Used to compute the HistoryStore maxSamples.  Must match the worldserver config.
#        Default:     5

ClusterServer.MgmtStatusInterval = 5

#
###################################################################################################

###################################################################################################
# WEB UI
#
#    Web.Enabled
#        Description: Enable the embedded Boost.Beast HTTP + WebSocket server.
#                     When enabled, the C9Core web UI is accessible at http://host:Web.Port/.
#        Default:     1

Web.Enabled = 1

#
#    Web.Port
#        Description: TCP port for the embedded web server.
#        Default:     9191

Web.Port = 9191

#
#    Web.BindAddr
#        Description: IP address to bind the web server to.
#                     "0.0.0.0" = all interfaces; "127.0.0.1" = localhost only.
#        Default:     "0.0.0.0"

Web.BindAddr = "0.0.0.0"

#
#    Map.TilesPath
#        Description: Local directory containing WoW 3.3.5a map tiles (Keira3-format).
#                     Directory structure: {TilesPath}/{mapId}/{z}/{x}/{y}.png
#                     Leave empty to serve empty placeholder tiles (map viewer shows labels only).
#        Default:     ""
#        Example:     "/home/wow/wowcluster/map-tiles"

Map.TilesPath = ""

#
###################################################################################################

###################################################################################################
# HISTORY
#
#    History.RetentionSeconds
#        Description: How many seconds of node health history to retain in memory.
#                     At the default 5s publish interval, 3600s = 720 samples per node.
#        Default:     3600

History.RetentionSeconds = 3600

#
###################################################################################################

###################################################################################################
# DEPLOY DEFAULTS
#    Pre-filled values for the Deploy Wizard (TUI F4 or web UI modal).
#

Deploy.WorldserverBin  = "./worldserver"
Deploy.NodemgrBin      = "./nodemgr"
Deploy.WorldserverConf = "./worldserver.conf"
Deploy.NodemgrConf     = "./nodemgr.conf"
Deploy.DefaultSSHUser  = "reno"
Deploy.DefaultSSHPort  = 22
Deploy.DefaultSSHKey   = "~/.ssh/id_rsa"
Deploy.DefaultRemotePath = "/home/wow/wowcluster"

#
###################################################################################################

###################################################################################################
# LOGGING
#

LogsDir = ""

Appender.Console=1,4,0,"1 9 3 6 5 8"
Appender.ClusterMgr=2,4,0,clustermgr.log,w

Logger.root=4,Console ClusterMgr
Logger.server.clustermgr=4,Console ClusterMgr
Logger.clustermgr=4,Console ClusterMgr
Logger.clustermgr.web=4,Console ClusterMgr

#
###################################################################################################
