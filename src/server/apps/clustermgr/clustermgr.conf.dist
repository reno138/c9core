##########################################
# C9Core Cluster Manager config file #
##########################################
[clustermgr]

###################################################################################################
# SECTION INDEX
#
#    NATS CONNECTION
#    WEB UI
#    HISTORY
#    DEPLOY DEFAULTS
#    LOGGING
#
###################################################################################################

###################################################################################################
# NATS CONNECTION
#
#    ClusterServer.NatsUrl
#        Description: NATS server URL.  Must point to the same NATS broker used by worldservers.
#                     clustermgr subscribes to cluster.mgmt.status and cluster.mgmt.players.
#        Default:     "nats://192.0.2.70:4222"

ClusterServer.NatsUrl = "nats://192.0.2.70:4222"

#
#    ClusterServer.NodeDeadThreshold
#        Description: Seconds of silence from a node's cluster.mgmt.status before it is marked
#                     CRASHED in the TUI and web UI.  Must be > ClusterServer.MgmtStatusInterval.
#        Default:     30

ClusterServer.NodeDeadThreshold = 30

#
#    ClusterServer.MgmtStatusInterval
#        Description: Expected publish interval (seconds) for cluster.mgmt.status from worldservers.
#                     Used to compute the HistoryStore maxSamples.  Must match the worldserver config.
#        Default:     5

ClusterServer.MgmtStatusInterval = 5

#
###################################################################################################

###################################################################################################
# UI
#
#    UI.Enabled
#        Description: Run the ncurses terminal UI on the main thread.
#                     Set to 0 to run headless — e.g. as a systemd service
#                     (see c9-clustermgr.service): the process keeps the NATS
#                     monitor and the web server running and exits on
#                     SIGINT/SIGTERM. With UI.Enabled=0 and Web.Enabled=0 there is
#                     nothing to do and clustermgr exits with an error.
#        Default:     1 - (Enabled: interactive TUI)
#                     0 - (Disabled: headless, web UI only)

UI.Enabled = 1

#
###################################################################################################

###################################################################################################
# WEB UI
#
#    Web.Enabled
#        Description: Enable the embedded Boost.Beast HTTP + WebSocket server.
#                     When enabled, the C9Core web UI is accessible at http://host:Web.Port/.
#        Default:     1

Web.Enabled = 1

#
#    Web.Port
#        Description: TCP port for the embedded web server.
#        Default:     9191

Web.Port = 9191

#
#    Web.BindAddr
#        Description: IP address to bind the web server to.
#                     "127.0.0.1" = this host only; "0.0.0.0" = all interfaces
#                     (needed when the operator browses from another VLAN).
#
#                     Everything the web UI serves is READ-ONLY unless
#                     Web.AuthToken is set — node names, states, history and
#                     player positions are visible to anyone who can reach the
#                     port, but nothing can be started, stopped or killed.
#        Default:     "127.0.0.1"

Web.BindAddr = "127.0.0.1"

#
#    Web.AuthToken
#        Description: Bearer token required on every mutating HTTP route:
#                     POST /api/nodes/{id}/{start|stop|kill|restart} and
#                     POST /api/deploy. Clients send it as
#                         Authorization: Bearer <token>
#                     Requests without it get 401; if this option is empty those
#                     routes answer 403 and node control over HTTP is disabled
#                     entirely (the TUI and the NATS-level control still work).
#
#                     The web UI has no login page; a browser client is expected
#                     to be a script or a reverse proxy that injects the header.
#
#                     Generate with:  openssl rand -hex 24
#        Default:     "" - (node control over HTTP disabled)

Web.AuthToken = ""

#
#    Map.TilesPath
#        Description: Local directory containing WoW 3.3.5a map tiles.
#                     Directory structure: {TilesPath}/{mapId}/{z}/{x}/{y}.png
#                     Leave empty to serve empty placeholder tiles (map viewer shows labels only).
#                     Only *.png tiles and *.json index files (e.g. maps.json
#                     written by the tile generator) are served from here.
#                     Requests are confined to this directory by path component;
#                     a sibling directory sharing the prefix is not reachable.
#        Default:     ""
#        Example:     "/home/wow/335/map-tiles"

Map.TilesPath = ""

#
###################################################################################################

###################################################################################################
# HISTORY
#
#    History.RetentionSeconds
#        Description: How many seconds of node health history to retain in memory.
#                     At the default 5s publish interval, 3600s = 720 samples per node.
#        Default:     3600

History.RetentionSeconds = 3600

#
###################################################################################################

###################################################################################################
# DEPLOY DEFAULTS
#    Pre-filled values for the Deploy Wizard (TUI F4). The wizard copies the two
#    binaries and two confs, then sets ClusterServer.NodeId/NatsURL/AuthKey and
#    ClusterServer.InstanceServer in worldserver.conf and NodeMgr.NodeId/NatsUrl/
#    AuthKey plus the Worldserver* paths in nodemgr.conf on the remote host.
#    NatsURL comes from ClusterServer.NatsUrl above and AuthKey from
#    ClusterMgr.AuthKey below. Any step that fails fails the deployment.
#

Deploy.WorldserverBin  = "./worldserver"
Deploy.NodemgrBin      = "./nodemgr"
Deploy.WorldserverConf = "./worldserver.conf"
Deploy.NodemgrConf     = "./nodemgr.conf"
Deploy.DefaultSSHUser  = "reno"
Deploy.DefaultSSHPort  = 22
Deploy.DefaultSSHKey   = "~/.ssh/id_rsa"
Deploy.DefaultRemotePath = "/home/wow/wowcluster"

#
###################################################################################################

###################################################################################################
# LOGGING
#

LogsDir = ""

Appender.Console=1,4,0,"1 9 3 6 5 8"
Appender.ClusterMgr=2,4,0,clustermgr.log,w

Logger.root=4,Console ClusterMgr
Logger.server.clustermgr=4,Console ClusterMgr
Logger.clustermgr=4,Console ClusterMgr
Logger.clustermgr.web=4,Console ClusterMgr

#
###################################################################################################

#
#    ClusterMgr.AuthKey
#        Description: Shared secret used to authenticate cluster-bus frames.
#                     MUST match ClusterServer.AuthKey on the worldservers and
#                     NodeMgr.AuthKey on the supervisors.
#
#                     Required for everything: the status, player and supervisor
#                     feeds are all sealed by their publishers and are dropped
#                     here if they do not verify, so without the key clustermgr
#                     sees no nodes at all. It is also what seals the control
#                     actions (F2 Start, F3 Stop, F6 Kill, F7 Restart, and the
#                     web /api/nodes endpoints); an unauthenticated control frame
#                     is never sent.
#
#                     Must be at least 32 bytes.
#
#                     Generate with:  openssl rand -hex 32
#
#        Default:     "" - (nothing verifies; no nodes shown, control refused)
#

ClusterMgr.AuthKey = ""
