########################################
# C9Core Node Manager config file #
########################################
[nodemgr]

###################################################################################################
# SECTION INDEX
#
#    PROXY CONNECTION
#    WORLDSERVER PROCESS
#    LOGGING
#
###################################################################################################

###################################################################################################
# STARTUP
#
#    NodeMgr.StartupDelay
#        Description: Seconds to wait before launching the worldserver after nodemgr starts.
#                     A small delay (3s) allows NATS and other cluster services to be ready first
#                     when multiple nodes start simultaneously.
#        Default:     3

NodeMgr.StartupDelay = 3

#
#    NodeMgr.MaxRestarts
#        Description: Maximum number of consecutive crash restarts before nodemgr gives up and exits.
#                     Set to 0 for unlimited restarts.
#                     After giving up, restart nodemgr manually to try again.
#        Default:     10

NodeMgr.MaxRestarts = 10

#
###################################################################################################

###################################################################################################
# WORLDSERVER PROCESS
#
#    WorldserverBin
#        Description: Full path to the worldserver binary.
#        Default:     "./worldserver"

WorldserverBin = "./worldserver"

#
#    WorldserverConfig
#        Description: Full path to the worldserver configuration file for this node.
#        Default:     "./worldserver.conf"

WorldserverConfig = "./worldserver.conf"

#
#    WorldserverLog
#        Description: Full path to the log file where worldserver stdout is redirected.
#        Default:     "/tmp/worldserver-node.log"

WorldserverLog = "/tmp/worldserver-node.log"

#
#    NodeMgr.UseGdb
#        Description: Launch the worldserver under GDB in batch mode so that crash
#                     backtraces (bt full) are automatically written to WorldserverLog.
#                     Requires gdb to be installed on the node.
#                     Disable this in production once debugging is complete.
#        Default:     0 - (Disabled — normal launch)
#                     1 - (Enabled  — launch under GDB)

NodeMgr.UseGdb = 0

#
###################################################################################################

###################################################################################################
# LOGGING
#

LogsDir = ""

Appender.Console=1,4,0,"1 9 3 6 5 8"
Appender.NodeMgr=2,4,0,nodemgr.log,w

Logger.root=4,Console NodeMgr
Logger.server.nodemgr=4,Console NodeMgr
Logger.nodemgr=4,Console NodeMgr

#
###################################################################################################
