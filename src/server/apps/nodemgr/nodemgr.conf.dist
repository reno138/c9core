########################################
# C9Core Node Manager config file #
########################################
[nodemgr]

###################################################################################################
# SECTION INDEX
#
#    STARTUP
#    WORLDSERVER PROCESS
#    LOGGING
#
###################################################################################################

###################################################################################################
# STARTUP
#
#    NodeMgr.StartupDelay
#        Description: Seconds to wait before launching the worldserver after nodemgr starts.
#                     A small delay (3s) allows NATS and other cluster services to be ready first
#                     when multiple nodes start simultaneously.
#        Default:     3

NodeMgr.StartupDelay = 3

#
#    NodeMgr.MaxRestarts
#        Description: Maximum number of consecutive crash restarts before nodemgr gives up and exits.
#                     Set to 0 for unlimited restarts.
#                     After giving up, restart nodemgr manually to try again.
#        Default:     10

NodeMgr.MaxRestarts = 10

#
###################################################################################################

###################################################################################################
# WORLDSERVER PROCESS
#
#    WorldserverBin
#        Description: Full path to the worldserver binary.
#        Default:     "./worldserver"

WorldserverBin = "./worldserver"

#
#    WorldserverConfig
#        Description: Full path to the worldserver configuration file for this node.
#        Default:     "./worldserver.conf"

WorldserverConfig = "./worldserver.conf"

#
#    WorldserverLog
#        Description: Full path to the log file where worldserver stdout is redirected.
#        Default:     "/tmp/worldserver-node.log"

WorldserverLog = "/tmp/worldserver-node.log"

#
#    NodeMgr.UseGdb
#        Description: Launch the worldserver under GDB in batch mode so that crash
#                     backtraces (bt full) are automatically written to WorldserverLog.
#                     Requires gdb to be installed on the node.
#                     Disable this in production once debugging is complete.
#        Default:     0 - (Disabled — normal launch)
#                     1 - (Enabled  — launch under GDB)

NodeMgr.UseGdb = 0

#
###################################################################################################

###################################################################################################
# LOGGING
#

LogsDir = ""

Appender.Console=1,4,0,"1 9 3 6 5 8"
Appender.NodeMgr=2,4,0,nodemgr.log,w

Logger.root=4,Console NodeMgr
Logger.server.nodemgr=4,Console NodeMgr
Logger.nodemgr=4,Console NodeMgr

#
###################################################################################################

#
#    NodeMgr.KillTimeout
#        Description: Seconds to wait after SIGTERM before escalating to SIGKILL
#                     when stopping the worldserver.
#
#                     A worldserver wedged in a game-loop deadlock never reaches
#                     its signal handler, so SIGTERM alone leaves the supervisor
#                     stuck in Stopping indefinitely. This escalation is what makes
#                     a hung node recoverable without shell access.
#
#                     Set high enough that a healthy server completes its normal
#                     shutdown (player saves, DB flush) first.
#
#        Default:     15 - (seconds)
#

NodeMgr.KillTimeout = 15

#
#    NodeMgr.NodeId
#        Description: Cluster node ID this supervisor manages. MUST match the
#                     ClusterServer.NodeId of the worldserver it launches.
#                     Used to build the control subject cluster.nodemgr.{NodeId}.
#
#        Default:     0 - (remote control disabled)
#

NodeMgr.NodeId = 0

#
#    NodeMgr.NatsUrl
#        Description: NATS URL for the supervisor control channel,
#                     e.g. "nats://192.0.2.20:4222".
#
#                     When set together with NodeMgr.NodeId and NodeMgr.AuthKey,
#                     the supervisor subscribes to cluster.nodemgr.{NodeId} for
#                     start/stop/kill/restart commands and publishes its own state
#                     to cluster.mgmt.nodemgr.
#
#                     This is deliberately a SEPARATE NATS connection from the
#                     worldserver's — the entire point is that it keeps working
#                     when the worldserver does not.
#
#                     A failure to connect is NOT fatal; the supervisor continues
#                     to manage the local process.
#
#        Default:     "" - (remote control disabled)
#

NodeMgr.NatsUrl = ""

#
#    NodeMgr.AuthKey
#        Description: Shared secret authenticating supervisor control frames. MUST
#                     match ClusterServer.AuthKey on the worldservers and
#                     ClusterMgr.AuthKey on clustermgr.
#
#                     Frames are HMAC-SHA256 authenticated with a timestamp and
#                     nonce (30-second replay window). Without it, anyone able to
#                     reach NATS could SIGKILL every worldserver in the cluster.
#
#                     What the key does NOT do: it is one secret shared by every
#                     worldserver, supervisor and clustermgr, so any holder can
#                     seal a frame claiming any sender id. Treat every node's
#                     config as holding cluster-wide supervisor authority.
#
#                     Must be at least 32 bytes. If unset or too short, remote
#                     control is disabled and a warning is logged — the supervisor
#                     never accepts unauthenticated commands.
#
#                     Generate with:  openssl rand -hex 32
#
#        Default:     "" - (remote control disabled)
#

NodeMgr.AuthKey = ""

#
#    NodeMgr.ControllerNodeIds
#        Description: Comma-separated list of sender (srcNode) ids whose sealed
#                     commands this supervisor will act on. clustermgr seals its
#                     start/stop/kill/restart frames as node 0.
#
#                     Commands from any other id are logged and dropped. Because
#                     the auth key is shared, this is a guard against wrong-subject
#                     traffic and mistakes, not against a peer that holds the key
#                     (see NodeMgr.AuthKey).
#
#                     Only frames whose message type is in the supervisor command
#                     range (0xC1-0xC4) are ever treated as commands; a sealed
#                     worldserver frame replayed onto this subject is rejected
#                     before this list is consulted.
#
#                     An empty list disables remote control (nothing would be
#                     accepted) and logs an error at startup.
#
#        Default:     "0" - (clustermgr only)
#

NodeMgr.ControllerNodeIds = "0"
