#   599  Halls of Stone                   600  Drak'Tharon Keep
#   601  Azjol-Nerub                      602  Halls of Lightning
#   604  Gundrak                          608  Violet Hold
#   619  Ahn'kahet: The Old Kingdom       632  The Forge of Souls
#   650  Trial of the Champion            658  Pit of Saron
#   668  Halls of Reflection
#
# MAP_RAID (raids):
#   249  Onyxia's Lair                    309  Zul'Gurub
#   409  Molten Core                      469  Blackwing Lair
#   509  Ruins of Ahn'Qiraj               531  Ahn'Qiraj Temple
#   532  Karazhan                         533  Naxxramas
#   534  The Battle for Mount Hyjal       544  Magtheridon's Lair
#   548  Serpentshrine Cavern             550  Tempest Keep
#   564  Black Temple                     565  Gruul's Lair
#   568  Zul'Aman                         580  The Sunwell
#   603  Ulduar                           615  The Obsidian Sanctum
#   616  The Eye of Eternity              624  Vault of Archavon
#   631  Icecrown Citadel                 649  Trial of the Crusader
#   724  The Ruby Sanctum
#
# MAP_BATTLEGROUND (battlegrounds):
#    30  Alterac Valley                   489  Warsong Gulch
#   529  Arathi Basin                     566  Eye of the Storm
#   607  Strand of the Ancients           628  Isle of Conquest
#
# MAP_ARENA (arenas):
#   559  Nagrand Arena                    562  Blade's Edge Arena
#   572  Ruins of Lordaeron               617  Dalaran Sewers
#   618  The Ring of Valor
#
###################################################################################################

###################################################################################################
# MYSQL SETTINGS
#
#    LoginDatabaseInfo
#        Description: Database connection settings for the auth database.
#                     The proxy needs read access to session keys for RC4 crypto initialization.
#        Example:     "hostname;port;username;password;database"
#        Default:     "127.0.0.1;3306;acore;acore;acore_auth"

LoginDatabaseInfo = "127.0.0.1;3306;acore;acore;acore_auth"

#
#    Database.Reconnect.Seconds
#    Database.Reconnect.Attempts
#
#        Description: How many seconds between every reconnection attempt
#                     and how many attempts will be performed in total
#        Default:     20 attempts every 15 seconds
#

Database.Reconnect.Seconds = 15
Database.Reconnect.Attempts = 20

#
#    LoginDatabase.WorkerThreads
#        Description: The amount of worker threads spawned to handle asynchronous (delayed) MySQL
#                     statements. Each worker thread is mirrored with its own connection to the
#        Default:     1

LoginDatabase.WorkerThreads = 1

#
#    LoginDatabase.SynchThreads
#        Description: The amount of MySQL connections spawned to handle.
#        Default:     1

LoginDatabase.SynchThreads = 1

#
# Database updater — disabled for proxy server (only authserver and worldserver update DBs)
Updates.EnableDatabases = 0
Updates.AutoSetup = 0
Updates.Redundancy = 0
Updates.ArchivedRedundancy = 0
Updates.AllowRehash = 1
Updates.CleanDeadRefMaxCount = 3
SourceDirectory = ""
MySQLExecutable = ""

#
###################################################################################################

###################################################################################################
#
#  LOGGING SYSTEM SETTINGS
#
#  Appender config values: Given an appender "name"
#    Appender.name
#        Description: Defines 'where to log'
#        Format:      Type,LogLevel,Flags,optional1,optional2,optional3
#
#                     Type
#                         0 - (None)
#                         1 - (Console)
#                         2 - (File)
#
#                     LogLevel
#                         0 - (Disabled)
#                         1 - (Fatal)
#                         2 - (Error)
#                         3 - (Warning)
#                         4 - (Info)
#                         5 - (Debug)
#                         6 - (Trace)
#
#                     Flags:
#                         0 - None
#                         1 - Prefix Timestamp to the text
#                         2 - Prefix Log Level to the text
#                         4 - Prefix Log Filter type to the text
#                         8 - Append timestamp to the log file name. Format: YYYY-MM-DD_HH-MM-SS
#                        16 - Make a backup of existing file before overwrite (Only used with Mode = w)
#
#                     Colors (read as optional1 if Type = Console)
#                         Format: "fatal error warn info debug trace"
#                         0 - BLACK,  1 - RED,    2 - GREEN,   3 - BROWN,  4 - BLUE
#                         5 - MAGENTA,6 - CYAN,   7 - GREY,    8 - YELLOW, 9 - LRED
#                        10 - LGREEN,11 - LBLUE, 12 - LMAGENTA,13 - LCYAN,14 - WHITE
#

Appender.Console=1,4,0,"1 9 3 6 5 8"
Appender.Proxy=2,4,0,Proxy.log,w

#  Logger config values: Given a logger "name"
#    Logger.name
#        Description: Defines 'What to log'
#        Format:      LogLevel,AppenderList

Logger.root=4,Console Proxy
Logger.server.proxyserver=4,Console Proxy
Logger.proxy=4,Console Proxy
Logger.sql.driver=3,Console Proxy

#
###################################################################################################
