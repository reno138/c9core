################################################
# C9Core Proxy Server configuration file #
################################################
[proxyserver]

###################################################################################################
# SECTION INDEX
#
#    PROXY SERVER SETTINGS
#    BACKEND SERVERS
#    MYSQL SETTINGS
#    LOGGING SYSTEM SETTINGS
#
###################################################################################################

###################################################################################################
# PROXY SERVER SETTINGS
#
#    LogsDir
#        Description: Logs directory setting.
#        Important:   LogsDir needs to be quoted, as the string might contain space characters.
#                     Logs directory must exists, or log file creation will be disabled.
#        Example:     "/home/youruser/c9core/logs"
#        Default:     "" - (Log files will be stored in the current path)

LogsDir = ""

#
#    MaxPingTime
#        Description: Time (in minutes) between database pings.
#        Default:     30

MaxPingTime = 30

#
#    PidFile
#        Description: Proxy server PID file.
#        Example:     "./proxyserver.pid"  - (Enabled)
#        Default:     ""                  - (Disabled)

PidFile = ""

#
#    BindIP
#        Description: Bind proxy server to IP/hostname.
#        Default:     "0.0.0.0" - (Bind to all IPs on the system)

BindIP = "0.0.0.0"

#
#    WorldServerPort
#        Description: TCP port the proxy listens on for WoW client connections.
#                     This is the port advertised in the realmlist. Clients connect here
#                     and the proxy transparently routes their traffic to the appropriate
#                     backend server. The client is never aware of the backend topology.
#        Default:     8085

WorldServerPort = 8085

#
#    NatsServer.URL
#        Description: NATS server URL for the cluster control channel.
#                     Backend worldservers and instance servers connect to NATS at this
#                     URL to register with the proxy and exchange all inter-node control
#                     messages (player directory, BG queues, chat relay, group updates,
#                     LFG relay, arena results, etc.).
#                     Replaces the old TCP ControlPort (8090). Requires nats-server to
#                     be running (see bin/nats-server).  No auth is required on a
#                     private LAN; add --auth <token> to nats-server and configure
#                     natsOptions_SetToken() if the NATS port is exposed externally.
#        Default:     "nats://127.0.0.1:4222"

NatsServer.URL = "nats://127.0.0.1:4222"

#
#    NodeMgrPort
#        Description: TCP port the proxy listens on for nodemgr daemon connections.
#                     nodemgr daemons connect here to register and receive start/stop commands.
#                     Communication is PSK-encrypted (see Management.SharedSecret).
#        Default:     8091

NodeMgrPort = 8091

#
#    ManagementPort
#        Description: TCP port the proxy listens on for clustermgr TUI connections.
#                     The clustermgr console app connects here for status and control.
#                     Communication is PSK-encrypted (see Management.SharedSecret).
#        Default:     9090

ManagementPort = 9090

#
#    Management.SharedSecret
#        Description: Pre-shared secret for encrypting nodemgr and clustermgr channels.
#                     Must be identical in proxyserver.conf, nodemgr.conf, and clustermgr.conf.
#                     CHANGE THIS before deploying to production.
#        Default:     "change-me"

Management.SharedSecret = "change-me"

#
#    Management.MaxPlayersPerNode
#        Description: Maximum number of players per worldserver node.
#                     Used by the round-robin router (to skip full nodes) and auto-scale.
#        Default:     500

Management.MaxPlayersPerNode = 500

#
#    RealmID
#        Description: The realm ID this proxy server represents.
#                     Must match the realm ID in the auth database realmlist table.
#        Default:     1

RealmID = 1

#
#    UseProcessors
#        Description: Processors mask for Windows and Linux based multi-processor systems.
#        Example:  For a computer with 3 CPUs:
#                     1 - 1st CPU only
#                     2 - 2nd CPU only
#                     4 - 3rd CPU only
#                     6 - 2nd + 3rd CPUs, because "2 | 4" -> 6
#        Default:     0  - (Selected by OS)
#                     1+ - (Bit mask value of selected processors)

UseProcessors = 0

#
#    ProcessPriority
#        Description: Process priority setting for Windows and Linux based systems.
#        Details:     On Linux, a nice value of -15 is used. (requires superuser). On Windows, process is set to HIGH class.
#        Default:     0 - (Normal)
#                     1 - (High)

ProcessPriority = 0

#
###################################################################################################

###################################################################################################
# BACKEND SERVERS
#
#    WorldServer.Address
#        Description: IP address of the worldserver (continents).
#                     The proxy connects here to forward continent-bound client traffic.
#        Default:     "127.0.0.1"

WorldServer.Node.Count = 1

WorldServer.Node.1.Address = "127.0.0.1"
WorldServer.Node.1.Port    = 8086

# WorldServer.Node.2.Address = "127.0.0.1"
# WorldServer.Node.2.Port    = 8087

# WorldServer.Node.3.Address = "127.0.0.1"
# WorldServer.Node.3.Port    = 8088

# WorldServer.Node.4.Address = "127.0.0.1"
# WorldServer.Node.4.Port    = 8089

# WorldServer.Node.5.Address = "127.0.0.1"
# WorldServer.Node.5.Port    = 8090

# Legacy single-node fallback (used when WorldServer.Node.Count = 0):
# WorldServer.Address = "127.0.0.1"
# WorldServer.Port    = 8086

#
#    ClusterServer.LFGMasterNode
#        Description: Which worldserver node ID runs the authoritative LFG/LFD matching queue.
#                     Non-master nodes relay LFG join/leave/proposal-response to this node.
#                     Must be a configured node (1–5). Node 1 is default.
#        Default:     1

ClusterServer.LFGMasterNode = 1

#
#    Cluster.RoutingMode
#        Description: How incoming WoW clients are distributed across worldserver nodes.
#                     roundrobin  — cycles through running nodes in order; skips full nodes.
#                     leastloaded — always picks the node with the fewest active players.
#        Default:     "roundrobin"

Cluster.RoutingMode = "roundrobin"

#
#    Cluster.AutoScale.*
#        Description: Automatic node start/stop based on cluster-wide player load.
#
#        Enable            — 0=disabled 1=enabled
#        ScaleUpThreshold  — Start a new node when load % of total capacity exceeds this.
#        ScaleDownThreshold— Stop a node when load % of total capacity drops below this.
#        MinNodes          — Always keep at least this many nodes running.
#        MaxNodes          — Never run more than this many nodes (even under load).
#        CooldownSeconds   — Minimum seconds between consecutive scale events.
#
#        Requires nodemgr daemons to be connected on NodeMgrPort.
#
#        Default:     disabled; thresholds 80%/30%; min 1; max 5; cooldown 300s

Cluster.AutoScale.Enable            = 0
Cluster.AutoScale.ScaleUpThreshold  = 80
Cluster.AutoScale.ScaleDownThreshold= 30
Cluster.AutoScale.MinNodes          = 1
Cluster.AutoScale.MaxNodes          = 5
Cluster.AutoScale.CooldownSeconds   = 300

#
#    InstanceServer.Address
#        Description: IP address of the instance server (dungeons, raids, BGs, arenas).
#                     The proxy connects here when rerouting a player to an instanced map.
#        Default:     "127.0.0.1"

InstanceServer.Address = "127.0.0.1"

#
#    InstanceServer.Port
#        Description: TCP port the instance server listens on for proxy connections.
#        Default:     8087

InstanceServer.Port = 8087

#
###################################################################################################
# ZONE-BASED MAP ROUTING
#
# MapRouting maps specific map IDs to specific cluster nodes.
# When a worldserver sends MSG_REROUTE_TO_MAP, the proxy consults this table to decide
# which node's backend address/port to forward the player to.
#
# Each entry is a pair of MapId and NodeId:
#    MapRouting.Count          = number of routing entries
#    MapRouting.X.MapId        = WoW map ID (from Map.dbc)
#    MapRouting.X.NodeId       = cluster node ID (matches WorldServer.Node.X config)
#    MapRouting.DefaultNode    = node ID for any map not explicitly listed (0 = round-robin)
#
# Example (3-node cluster):
#    Node 1 handles Eastern Kingdoms (0) + Kalimdor (1)
#    Node 2 handles Outland (530) + Northrend (571)
#    Node 3 handles all instances (default)
#
#    MapRouting.Count       = 4
#    MapRouting.1.MapId     = 0
#    MapRouting.1.NodeId    = 1
#    MapRouting.2.MapId     = 1
#    MapRouting.2.NodeId    = 1
#    MapRouting.3.MapId     = 530
#    MapRouting.3.NodeId    = 2
#    MapRouting.4.MapId     = 571
#    MapRouting.4.NodeId    = 2
#    MapRouting.DefaultNode = 3
#
###################################################################################################

MapRouting.Count       = 4
MapRouting.1.MapId     = 0
MapRouting.1.NodeId    = 1
MapRouting.2.MapId     = 1
MapRouting.2.NodeId    = 1
MapRouting.3.MapId     = 530
MapRouting.3.NodeId    = 2
MapRouting.4.MapId     = 571
MapRouting.4.NodeId    = 2
MapRouting.DefaultNode = 3

#
###################################################################################################
